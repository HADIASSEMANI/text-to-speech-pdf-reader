QMainWindow {
    background: #0d0f12;
}

QWidget {
    color: #e6e8eb;
    font-family: "Segoe UI";
    font-size: 14px;
}

QLabel#pageTitle {
    font-size: 30px;
    font-weight: 600;
}

QLabel#readerTitle {
    font-size: 22px;
    font-weight: 600;
}

QLabel#readerStatus {
    color: #969ba4;
    font-size: 13px;
}

QLabel#secondaryText {
    color: #969ba4;
}


/* ----------------------------------
   Reading surface
---------------------------------- */

QTextEdit#readerText {
    background: #15181d;

    border: 1px solid #22262d;
    border-radius: 18px;

    padding: 32px;

    font-size: 18px;
}


/* ----------------------------------
   Buttons
---------------------------------- */

QPushButton {
    background: #191c21;

    border: 1px solid #292e36;

    border-radius: 10px;

    padding: 10px 16px;

    min-height: 20px;
}

QPushButton:hover {
    background: #22262d;

    border-color: #383f49;
}

QPushButton:pressed {
    background: #292e36;
}

QPushButton:disabled {
    color: #5a5f68;
    border-color: #22262d;
}


QPushButton#primaryButton {
    background: #f1f3f5;
    color: #121417;

    border: none;

    font-weight: 600;
}


QPushButton#primaryButton:hover {
    background: #ffffff;
}


QPushButton#primaryPlayerButton {
    min-width: 80px;
    min-height: 36px;

    border-radius: 18px;

    background: #f1f3f5;
    color: #111317;

    font-weight: 600;
}


QPushButton#ghostButton {
    background: transparent;
    border: none;

    color: #a8adb5;
}


QPushButton#ghostButton:hover {
    color: #ffffff;
}


/* ----------------------------------
   Library
---------------------------------- */

QPushButton#bookCard {
    text-align: left;

    background: #15181d;

    border: 1px solid #22262d;
    border-radius: 14px;

    padding: 18px;

    font-size: 16px;
}


QPushButton#bookCard:hover {
    background: #1b1f25;

    border-color: #353b45;
}

QPushButton#deleteBookButton {
    color: #ff9b9b;
    border-color: #4a2d32;
    min-width: 64px;
}

QPushButton#deleteBookButton:hover {
    color: #ffffff;
    background: #7a2833;
    border-color: #a53a48;
}


/* ----------------------------------
   SpinBox
---------------------------------- */

QSpinBox,
QDoubleSpinBox,
QComboBox {
    background: #15181d;

    border: 1px solid #292e36;
    border-radius: 8px;

    padding: 7px 10px;
}


/* ----------------------------------
   Slider
---------------------------------- */

QSlider::groove:horizontal {
    height: 5px;

    background: #272c33;

    border-radius: 2px;
}


QSlider::handle:horizontal {
    width: 16px;
    height: 16px;

    margin: -6px 0;

    border-radius: 8px;

    background: #f2f3f5;
}


QSlider::sub-page:horizontal {
    background: #8c929c;

    border-radius: 2px;
}


/* ----------------------------------
   Loading screen
---------------------------------- */

QProgressBar {
    background: #1b1e23;

    border: none;
    border-radius: 3px;

    min-height: 6px;
    max-height: 6px;
}


QProgressBar::chunk {
    background: #e7e9ec;

    border-radius: 3px;
}


/* ----------------------------------
   Scroll area
---------------------------------- */

QScrollArea {
    border: none;
    background: transparent;
}


QScrollBar:vertical {
    background: transparent;
    width: 10px;
}


QScrollBar::handle:vertical {
    background: #30353d;

    border-radius: 5px;

    min-height: 30px;
}


QPushButton#bookCardMissing {
    text-align: left;

    background: #15181d;

    border: 1px solid #3a2a2d;
    border-radius: 14px;

    padding: 18px;

    font-size: 16px;

    color: #8c929b;
}


QPushButton#bookCardMissing:hover {
    border-color: #5a3a40;
}


/* ----------------------------------
   File picker

   Qt draws this dialog itself, so it inherits the app palette instead of
   the shell's. Everything it shows needs a background of its own: the base
   QWidget rule only sets a light text colour.
---------------------------------- */

QFileDialog {
    background: #0d0f12;
}


QFileDialog QLabel {
    color: #b9bec7;
}


QFileDialog QListView,
QFileDialog QTreeView {
    background: #12151a;
    color: #e6e8eb;

    border: 1px solid #292e36;
    border-radius: 8px;

    outline: none;
}


QFileDialog QListView::item,
QFileDialog QTreeView::item {
    padding: 4px;

    border-radius: 4px;
}


QFileDialog QListView::item:hover,
QFileDialog QTreeView::item:hover {
    background: #1b1f26;
}


QFileDialog QListView::item:selected,
QFileDialog QTreeView::item:selected {
    background: #2a3140;
    color: #ffffff;
}


QFileDialog QHeaderView::section {
    background: #191c21;
    color: #b9bec7;

    border: none;

    padding: 6px;
}


QFileDialog QLineEdit {
    background: #15181d;
    color: #e6e8eb;

    border: 1px solid #292e36;
    border-radius: 8px;

    padding: 7px 10px;

    selection-background-color: #2a3140;
}


QFileDialog QToolButton {
    background: #191c21;

    border: 1px solid #292e36;
    border-radius: 8px;

    padding: 5px;
}


QFileDialog QToolButton:hover {
    background: #22262d;

    border-color: #383f49;
}


QFileDialog QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}


QFileDialog QScrollBar::handle:horizontal {
    background: #30353d;

    border-radius: 5px;

    min-width: 30px;
}


/* The popup is a window of its own, so it is not reached by a
   `QFileDialog QComboBox` selector. This also fixes the chapter list. */

QComboBox QAbstractItemView {
    background: #12151a;
    color: #e6e8eb;

    border: 1px solid #292e36;

    outline: none;

    selection-background-color: #2a3140;
    selection-color: #ffffff;
}
